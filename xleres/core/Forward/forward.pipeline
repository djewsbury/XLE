#include "../Config/main.pipeline"
#include "../Config/shadow-template.pipeline"

DescriptorSet ForwardLighting
{
	UniformBuffer EnvironmentProps;						// 0
	UnorderedAccessBuffer LightList;					// 1
	UnorderedAccessBuffer LightDepthTable;				// 2
	SampledTexture TiledLightBitField;					// 3

	SampledTexture SSR;									// 4
	SampledTexture SSRConfidence;						// 5
	SampledTexture SSAOTexture;							// 6

	SampledTexture DynamicShadowDatabase;				// 7
	UnorderedAccessBuffer DynamicShadowProperties;		// 8

	SampledTexture DynamicCubeShadowDatabase;			// 9
	UnorderedAccessBuffer DynamicCubeShadowProperties;	// 10

	SampledTexture StaticShadowProbeDatabase;			// 11
	UnorderedAccessBuffer StaticShadowProbeProperties;	// 12

	SampledTexture NoiseTexture;						// 13

	SampledTexture SpecularIBL;							// 14
	SampledTexture GlossLUT;							// 15

	Sampler ShadowSampler								// 16
	{
		Filter = ComparisonBilinear,
		AddressU = Border,
		AddressV = Border,
		Comparison = GreaterEqual
	};
	Sampler ShadowDepthSampler							// 17
	{
		Filter = Bilinear,
		AddressU = Border,
		AddressV = Border
	};
};

DescriptorSet ProbePrepareLighting
{
	UniformBuffer EnvironmentProps;						// 0
};

PipelineLayout GraphicsForwardPlus
{
	AutoDescriptorSet Numeric;				// 0
	DescriptorSet Sequencer;				// 1
	DescriptorSet ForwardLighting;			// 2
	DescriptorSet ShadowTemplate;			// 3
	DescriptorSet Material;					// 4

	VSPushConstants LocalTransform
	{
		float3x4 LocalToWorld;
		float3 LocalSpaceView;
		uint Dummy;
	};
};

PipelineLayout GraphicsProbePrepare
{
	AutoDescriptorSet Numeric;				// 0
	DescriptorSet Sequencer;				// 1
	DescriptorSet ProbePrepareLighting;		// 2
	DescriptorSet Spacer;					// 3
	DescriptorSet Material;					// 4

	VSPushConstants LocalTransform
	{
		float3x4 LocalToWorld;
		float3 LocalSpaceView;
		uint ViewMask;
	};
};

